# Copy this file to .env in this same folder and fill in real values.
# Loaded automatically by application.properties (spring.config.import).
# Do not commit .env.
DB_USERNAME=root
DB_PASSWORD=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Leave unset for local http://localhost dev; set to true once deployed behind HTTPS.
COOKIE_SECURE=
ADMIN_SEED_EMAIL=admin@securekyc.local
ADMIN_SEED_PASSWORD=
TESSERACT_PATH=
